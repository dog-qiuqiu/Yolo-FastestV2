[name]
model_name=wildlife

[train-configure]
epochs=300
steps=150,250
batch_size=64
subdivisions=1
learning_rate=0.001

[model-configure]
pre_weights=./modelzoo/coco2017-0.241078ap-model.pth
classes=4
width=416
height=416
anchor_num=3
anchors=41.47,61.69, 84.17,116.76, 106.11,230.36, 159.28,161.53, 191.68,257.35, 280.38,280.09

[data-configure]
train=./data/wildlife/train.txt
val=./data/wildlife/valid.txt
test=./data/wildlife/test.txt
names=./data/wildlife/wildlife.names
val_annotations=./data/wildlife/annotations/valid.json
test_annotations=./data/wildlife/annotations/test.json
